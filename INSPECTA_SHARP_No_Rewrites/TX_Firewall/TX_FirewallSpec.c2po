-- C2PO Specification Valid with C2PO/R2U2 v4.0 or greater
INPUT
	tx_output: bool;
	Operating_Mode: int;
	arp_wellformed: bool;
	ipv4_wellformed: bool;
	tx_input: bool;
	tx_output_matches_input: bool;
DEFINE
	OperatingMode_Normal := Operating_Mode == 0;
FTSPEC
	-- WARNING: The following spec (Blocked_Messages_Frequency) includes M (i.e., end of mission-time) in a temporal interval.
	-- If M is large, this specification may result in high memory usage.
	-- Please specify M manually in this file or with the --mission-time flag in C2PO.
	Blocked_Messages_Frequency: (((! ((! OperatingMode_Normal) && (F[1,1] OperatingMode_Normal))) || (F[1,1] ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((prev(false,tx_input) && (! prev(false,tx_output))) -> ((G[0,9] (! (tx_input && (! tx_output)))) || ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] (! (tx_input && (! tx_output))))))))) && ((TAU == 0) -> (OperatingMode_Normal -> ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((prev(false,tx_input) && (! prev(false,tx_output))) -> ((G[0,9] (! (tx_input && (! tx_output)))) || ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] (! (tx_input && (! tx_output))))))))));
	Operating_Mode: ((Operating_Mode <= 1) && (Operating_Mode >= 0));
	Input_To_Output_Forward_ARP: ((tx_input && arp_wellformed) -> (tx_output && tx_output_matches_input));
	Input_To_Output_Block_Frame: ((tx_input && (! (arp_wellformed || ipv4_wellformed))) -> (! tx_output));
	Input_To_Output_Forward_IPv4: ((tx_input && ipv4_wellformed) -> (tx_output && tx_output_matches_input));
	Input_To_Output_Block: ((! tx_input) -> (! tx_output));
