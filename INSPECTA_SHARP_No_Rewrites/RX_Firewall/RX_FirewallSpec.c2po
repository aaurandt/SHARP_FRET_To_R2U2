-- C2PO Specification Valid with C2PO/R2U2 v4.0 or greater
INPUT
	mav_output: bool;
	vmm_output: bool;
	Operating_Mode: int;
	arp_wellformed: bool;
	ipv4_wellformed: bool;
	rx_input: bool;
	rx_output_matches_input: bool;
	udp_dest_ardupilot: bool;
	udp_dest_whitelisted: bool;
	udp_src_GCS: bool;
	udp_wellformed: bool;
DEFINE
	OperatingMode_Normal := Operating_Mode == 0;
	OperatingMode_Recovery := Operating_Mode == 1;
	rx_output := mav_output || vmm_output;
FTSPEC
	-- WARNING: The following spec (Input_To_Output_VMM_UDP) includes M (i.e., end of mission-time) in a temporal interval.
	-- If M is large, this specification may result in high memory usage.
	-- Please specify M manually in this file or with the --mission-time flag in C2PO.
	Input_To_Output_VMM_UDP: (((! ((! OperatingMode_Normal) && (F[1,1] OperatingMode_Normal))) || (F[1,1] ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((((((rx_input && ipv4_wellformed) && udp_wellformed) && (! udp_src_GCS)) && (! udp_dest_ardupilot)) && udp_dest_whitelisted) -> ((vmm_output && rx_output_matches_input) && (! mav_output)))))) && ((TAU == 0) -> (OperatingMode_Normal -> ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((((((rx_input && ipv4_wellformed) && udp_wellformed) && (! udp_src_GCS)) && (! udp_dest_ardupilot)) && udp_dest_whitelisted) -> ((vmm_output && rx_output_matches_input) && (! mav_output)))))));
	Operating_Mode: ((Operating_Mode <= 1) && (Operating_Mode >= 0));
	-- WARNING: The following spec (Input_To_Output_VMM_ARP) includes M (i.e., end of mission-time) in a temporal interval.
	-- If M is large, this specification may result in high memory usage.
	-- Please specify M manually in this file or with the --mission-time flag in C2PO.
	Input_To_Output_VMM_ARP: (((! ((! OperatingMode_Normal) && (F[1,1] OperatingMode_Normal))) || (F[1,1] ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((rx_input && arp_wellformed) -> ((vmm_output && rx_output_matches_input) && (! mav_output)))))) && ((TAU == 0) -> (OperatingMode_Normal -> ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((rx_input && arp_wellformed) -> ((vmm_output && rx_output_matches_input) && (! mav_output)))))));
	Recovery_Output: (OperatingMode_Recovery -> (! rx_output));
	Input_To_Output_Block_Frame: ((rx_input && (! (arp_wellformed || ((ipv4_wellformed && udp_wellformed) && ((udp_src_GCS && udp_dest_ardupilot) || (((! udp_src_GCS) && (! udp_dest_ardupilot)) && udp_dest_whitelisted)))))) -> (! rx_output));
	-- WARNING: The following spec (Blocked_Messages_Frequency) includes M (i.e., end of mission-time) in a temporal interval.
	-- If M is large, this specification may result in high memory usage.
	-- Please specify M manually in this file or with the --mission-time flag in C2PO.
	Blocked_Messages_Frequency: (((! ((! OperatingMode_Normal) && (F[1,1] OperatingMode_Normal))) || (F[1,1] ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((prev(false,rx_input) && (! (prev(false,mav_output) || prev(false,vmm_output)))) -> ((G[0,9] (! (rx_input && (! rx_output)))) || ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] (! (rx_input && (! rx_output))))))))) && ((TAU == 0) -> (OperatingMode_Normal -> ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] ((prev(false,rx_input) && (! (prev(false,mav_output) || prev(false,vmm_output)))) -> ((G[0,9] (! (rx_input && (! rx_output)))) || ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] (! (rx_input && (! rx_output))))))))));
	-- WARNING: The following spec (Input_To_Output_MAVLink) includes M (i.e., end of mission-time) in a temporal interval.
	-- If M is large, this specification may result in high memory usage.
	-- Please specify M manually in this file or with the --mission-time flag in C2PO.
	Input_To_Output_MAVLink: (((! ((! OperatingMode_Normal) && (F[1,1] OperatingMode_Normal))) || (F[1,1] ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] (((((rx_input && ipv4_wellformed) && udp_wellformed) && udp_src_GCS) && udp_dest_ardupilot) -> ((mav_output && rx_output_matches_input) && (! vmm_output)))))) && ((TAU == 0) -> (OperatingMode_Normal -> ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,M] (((((rx_input && ipv4_wellformed) && udp_wellformed) && udp_src_GCS) && udp_dest_ardupilot) -> ((mav_output && rx_output_matches_input) && (! vmm_output)))))));
	Input_To_Output_Block: ((! rx_input) -> (! rx_output));
