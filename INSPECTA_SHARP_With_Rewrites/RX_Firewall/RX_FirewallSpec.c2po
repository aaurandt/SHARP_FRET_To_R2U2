-- C2PO Specification Valid with C2PO/R2U2 v4.0 or greater
INPUT
	mav_output: bool;
	vmm_output: bool;
	Operating_Mode: int;
	arp_wellformed: bool;
	ipv4_wellformed: bool;
	rx_input: bool;
	rx_output_matches_input: bool;
	udp_dest_ardupilot: bool;
	udp_dest_whitelisted: bool;
	udp_src_GCS: bool;
	udp_wellformed: bool;
DEFINE
	OperatingMode_Normal := Operating_Mode == 0;
	OperatingMode_Recovery := Operating_Mode == 1;
	rx_output := mav_output || vmm_output;
FTSPEC
	Input_To_Output_VMM_UDP: ((OperatingMode_Normal && (((((rx_input && ipv4_wellformed) && udp_wellformed) && (! udp_src_GCS)) && (! udp_dest_ardupilot)) && udp_dest_whitelisted)) -> ((vmm_output && rx_output_matches_input) && (! mav_output)));
	Operating_Mode: ((Operating_Mode <= 1) && (Operating_Mode >= 0));
	Input_To_Output_VMM_ARP: ((OperatingMode_Normal && (rx_input && arp_wellformed)) -> ((vmm_output && rx_output_matches_input) && (! mav_output)));
	Recovery_Output: (OperatingMode_Recovery -> (! rx_output));
	Input_To_Output_Block_Frame: ((rx_input && (! (arp_wellformed || ((ipv4_wellformed && udp_wellformed) && ((udp_src_GCS && udp_dest_ardupilot) || (((! udp_src_GCS) && (! udp_dest_ardupilot)) && udp_dest_whitelisted)))))) -> (! rx_output));
	Blocked_Messages_Frequency: ((OperatingMode_Normal && (prev(false,rx_input) && (! (prev(false,mav_output) || prev(false,vmm_output))))) -> ((OperatingMode_Normal && (F[1,1] (! OperatingMode_Normal))) R[0,9] (rx_input -> rx_output)));
	Input_To_Output_MAVLink: ((OperatingMode_Normal && ((((rx_input && ipv4_wellformed) && udp_wellformed) && udp_src_GCS) && udp_dest_ardupilot)) -> ((mav_output && rx_output_matches_input) && (! vmm_output)));
	Input_To_Output_Block: ((! rx_input) -> (! rx_output));
